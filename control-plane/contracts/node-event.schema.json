{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teremoq.invalid/control-plane/node-event.schema.json",
  "title": "Teremoq node lifecycle event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "partition", "sequence", "generation", "node_id", "state", "observed_at", "image_digest", "config_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "partition": {"type": "string", "minLength": 1, "maxLength": 63},
    "sequence": {"type": "integer", "minimum": 0},
    "generation": {"type": "integer", "minimum": 1},
    "node_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "state": {"enum": ["requested", "provisioning", "bootstrapping", "authenticated", "registered", "ready", "draining", "terminated", "failed", "replacing"]},
    "observed_at": {"type": "integer", "minimum": 0},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
