{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teremoq.invalid/control-plane/metrics-sample.schema.json",
  "title": "Teremoq aggregate capacity metrics sample",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_id", "partition", "sequence", "observed_at", "authorized_viewers", "active_sessions", "egress_mbps", "reservations", "auth_context"],
  "properties": {
    "schema_version": {"const": 1},
    "sample_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "partition": {"type": "string", "minLength": 1, "maxLength": 63},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "observed_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "authorized_viewers": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "active_sessions": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "egress_mbps": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "auth_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_id", "principal_ref", "verified_at"],
      "properties": {
        "verification_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "principal_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "verified_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "reservations": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reservation_id", "viewers", "expires_at", "authorization_id", "nonce"],
        "properties": {
          "reservation_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "viewers": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "expires_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "authorization_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "nonce": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    }
  }
}
