{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teremoq.local/schemas/agents_schema.json",
  "title": "Teremoq AIOps Agent Message",
  "description": "Esquema de comunicación entre agentes locales (n8n + Ollama) para análisis de red y operaciones del gateway.",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "trigger_event", "analysis_result", "action_required"],
  "properties": {
    "role": {
      "type": "string",
      "description": "Identidad funcional del agente emisor.",
      "enum": [
        "network_analyst",
        "gateway_ops",
        "telemetry_analyst",
        "incident_coordinator"
      ]
    },
    "trigger_event": {
      "type": "object",
      "description": "Evento que dispara el ciclo de análisis (p. ej. logs JSON de tracing del gateway).",
      "additionalProperties": false,
      "required": ["type", "timestamp"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "object_dropped",
            "quic_timeout",
            "congestion",
            "node_state_change",
            "srt_ingest_loss"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "description": "Componente origen del evento (p. ej. gateway-rs)."
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "analysis_result": {
      "type": "object",
      "description": "Salida del razonamiento del LLM local (Ollama).",
      "additionalProperties": false,
      "required": ["summary", "severity"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "critical"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "affected_tracks": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "action_required": {
      "type": "object",
      "description": "Acción operativa que n8n debe ejecutar o escalar.",
      "additionalProperties": false,
      "required": ["needed", "type"],
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "none",
            "drop_priority_2",
            "notify_ops",
            "adjust_bitrate_hint",
            "redis_node_update"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
